# ═══════════════════════════════════════════════════════════════════════════════
# agente01 — SPY Specialist — Variables de entorno
# Copiar a .env y completar los valores. NUNCA commitear .env.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Símbolo primario ──────────────────────────────────────────────────────────
SYMBOL=SPY

# ── Twelve Data (fallback cuando Yahoo Finance se bloquea) ────────────────────
# Plan gratuito: 800 calls/día, 8/min — https://twelvedata.com
TWELVE_DATA_API_KEY=your_twelvedata_key_here

# ── NewsAPI ───────────────────────────────────────────────────────────────────
# Plan gratuito: 100 requests/día — https://newsapi.org
NEWSAPI_KEY=your_newsapi_key_here

# ── FRED API (OBLIGATORIO) ────────────────────────────────────────────────────
# Fuente oficial de datos económicos USA. Registro gratuito:
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# ── Webhook (bot1) ───────────────────────────────────────────────────────────
WEBHOOK_SECRET=your_shared_webhook_secret_here
WEBHOOK_URL=http://127.0.0.1:8000/webhook/bot2

# ── Ciclo ────────────────────────────────────────────────────────────────────
CYCLE_INTERVAL_MINUTES=60
PRE_MARKET_BRIEFING_TIME_ET=07:00
PRIORITY_CYCLES_ET=09:45,12:30,15:30

# ── Umbrales de decisión ─────────────────────────────────────────────────────
# MIN_CONFIDENCE subido a 0.72 (análisis de 6 dimensiones es más exigente)
MIN_CONFIDENCE=0.72
# MIN_DIMENSIONS_PASSING: cuántas de las 6 dimensiones deben superar 0.55
MIN_DIMENSIONS_PASSING=5
CONSENSUS_REQUIRED=3
COOLDOWN_HOURS=24

# ── Ventanas de datos ────────────────────────────────────────────────────────
NEWS_LOOKBACK_HOURS=4
PRICE_HISTORY_DAYS=60

# ── Pesos por dimensión (deben sumar 1.0) ────────────────────────────────────
WEIGHT_MACRO=0.25
WEIGHT_COMPONENTS=0.20
WEIGHT_SENTIMENT=0.15
WEIGHT_TECHNICAL=0.20
WEIGHT_EVENTS=0.10
WEIGHT_CROSS_ASSET=0.10

# ── Trailing stop dinámico por régimen VIX ───────────────────────────────────
EXIT_STRATEGY=trailing_stop
TRAIL_PERCENT_LOW_VIX=3.0
TRAIL_PERCENT_MODERATE_VIX=4.0
TRAIL_PERCENT_HIGH_VIX=5.5
TAKE_PROFIT_HIGH_VIX=8.0
BLOCK_NEW_ON_EXTREME_VIX=true

MAX_HOLDING_DAYS_LOW=15
MAX_HOLDING_DAYS_MODERATE=10
MAX_HOLDING_DAYS_HIGH=7

# ── Eventos / modo defensivo ─────────────────────────────────────────────────
ECONOMIC_CALENDAR_SOURCE=investing
# Horas antes/después de FOMC en las que se bloquean nuevas entradas
FOMC_BLOCK_HOURS_BEFORE=24
FOMC_BLOCK_HOURS_AFTER=2
# Bloquea si hay ≥N earnings de top-10 holdings en las próximas 48h
EARNINGS_TOP10_THRESHOLD=3

# ── Position sizing (tiers por score — single-asset SPY) ─────────────────────
# score ≥ 0.90 → 25% del capital
SIZE_TIER_1=0.25
# score ≥ 0.82 → 18%
SIZE_TIER_2=0.18
# score ≥ 0.75 → 12%
SIZE_TIER_3=0.12
# score ≥ 0.72 → 8%  (mínimo aceptable)
SIZE_TIER_4=0.08

# ── Modo de operación ────────────────────────────────────────────────────────
# true  -> solo loguea, NO envía webhook real a bot1
# false -> envía webhook real
DRY_RUN=true

# ── Telegram (opcional) ──────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
